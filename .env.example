# Razorpay (required for checkout to work — get test/live keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (optional — sends an order/prescription notification email to the pharmacist)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=info@milarch.in

# VaartaBot (optional — sends a WhatsApp notification for new enquiries/orders)
# API key from the Milarch Pharma tenant's VaartaBot dashboard (Settings > API Keys)
VAARTABOT_API_URL=https://vaartabot.com
VAARTABOT_API_KEY=
# Comma-separated list — one WhatsApp message is sent to each
VAARTABOT_NOTIFY_PHONES=917799900068,918686903927,919397817541
